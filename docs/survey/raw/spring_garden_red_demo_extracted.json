  "guestbook": {
    "wishes": [
      {
        "author": "Anh Phước",
        "time": "1:45:14 19/12/2025",
        "content": "Chúc hai em trăm năm hạnh phúc"
      },
      {
        "author": "Cậu Khanh",
        "time": "1:44:49 19/12/2025",
        "content": "Chúc hai cháu nên duyên vợ chồng, sống với nhau hòa thuận, hạnh phúc lâu dài"
      },
      {
        "author": "Chị Mai",
        "time": "1:44:12 19/12/2025",
        "content": "Mừng ngày trọng đại, chúc hai đứa mãi mãi hạnh phúc bên nhau"
      },
      {
        "author": "Bà Nội cô Dâu",
        "time": "1:43:29 19/12/2025",
        "content": "Chúc hai con sống bên nhau thuận hòa, hạnh phúc lâu dài, gia đình sum vầy"
      },
      {
        "author": "Dì Minh",
        "time": "1:42:59 19/12/2025",
        "content": "Mong hai cháu luôn yêu thương, tôn trọng nhau, xây dựng gia đình hạnh phúc"
      },
      {
        "author": "Dì Tâm",
        "time": "1:42:47 19/12/2025",
        "content": "Chúc hai cháu trăm năm hạnh phúc, vợ chồng hòa thuận, gia đình yên ấm"
      },
      {
        "author": "Bé Diệu",
        "time": "1:42:28 19/12/2025",
        "content": "Chúc hai anh chị hạnh phúc viên mãn, gia đình êm ấm, vạn sự như ý"
      },
      {
        "author": "Đình Trọng k22",
        "time": "1:42:02 19/12/2025",
        "content": "Chúc hai bạn trăm năm hạnh phúc, yêu thương nhau thật nhiều và sớm có tin vui"
      },
      {
        "author": "Thương Thương",
        "time": "1:41:39 19/12/2025",
        "content": "Chúc vợ chồng son luôn vui vẻ, thuận hòa, cùng nhau xây dựng tổ ấm hạnh phúc"
      },
      {
        "author": "Linh A4",
        "time": "1:41:18 19/12/2025",
        "content": "Chúc hai bạn trăm năm hạnh phúc, yêu thương nhau mãi mãi."
      }
    ]
