{"html":"<div class=\"fixed inset-0 z-[9999] flex items-center justify-center p-4 transition-all duration-300 bg-black/60 backdrop-blur-sm\"><div class=\"bg-white rounded-2xl shadow-2xl max-w-md w-full max-h-[85vh] relative overflow-hidden transition-all duration-300 scale-100 opacity-100\"><div class=\"relative px-6 pt-6 pb-4\"><button class=\"absolute top-4 right-4 w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 text-gray-500 hover:bg-gray-200 hover:text-gray-700 transition-colors\" aria-label=\"Đóng\"><svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"></path></svg></button></div><div class=\"px-6 pb-6 overflow-y-auto max-h-[calc(85vh-72px)]\"><div data-showcase-keep=\"\" class=\"\"><h2 class=\"text-xl font-semibold text-gray-900 mb-1\"><span dir=\"auto\">Xác nhận tham dự</span></h2><div class=\"text-sm text-gray-500 mb-6\"><span dir=\"auto\">Sự hiện diện của bạn là niềm vinh hạnh cho gia đình chúng tôi. Xin xác nhận để chúng tôi chuẩn bị chu đáo nhất.</span></div><form class=\"space-y-4\"><div><label class=\"block text-sm font-medium text-gray-700 mb-1.5\"><span dir=\"auto\">Tên của bạn</span></label><input required=\"\" placeholder=\"Nhập tên của bạn\" class=\"w-full px-4 py-3 border border-gray-200 rounded-xl text-base sm:text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition-shadow placeholder:text-gray-400 bg-white text-gray-900\" type=\"text\" value=\"\"></div><div><label class=\"block text-sm font-medium text-gray-700 mb-2\"><span dir=\"auto\">Bạn sẽ đến chứ?</span></label><div class=\"space-y-2\"><label class=\"flex items-center gap-3 py-2.5 px-3 rounded-xl border-2 cursor-pointer transition-all duration-200 border-gray-100 bg-gray-50/50 hover:border-gray-200 hover:bg-gray-50\"><input class=\"sr-only\" type=\"radio\" value=\"yes\" name=\"attending\"><div class=\"w-8 h-8 rounded-full flex items-center justify-center transition-colors bg-gray-200\"><svg class=\"w-4 h-4 text-gray-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg></div><span class=\"text-sm font-medium text-gray-700\"><span dir=\"auto\">Tôi sẽ đến</span></span></label><label class=\"flex items-center gap-3 py-2.5 px-3 rounded-xl border-2 cursor-pointer transition-all duration-200 border-gray-100 bg-gray-50/50 hover:border-gray-200 hover:bg-gray-50\"><input class=\"sr-only\" type=\"radio\" value=\"no\" name=\"attending\"><div class=\"w-8 h-8 rounded-full flex items-center justify-center transition-colors bg-gray-200\"><svg class=\"w-4 h-4 text-gray-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"></path></svg></div><span class=\"text-sm font-medium text-gray-700\"><span dir=\"auto\">Rất tiếc, tôi không thể đến</span></span></label></div></div><button type=\"submit\" disabled=\"\" class=\"w-full py-3.5 text-sm font-semibold rounded-xl transition-all duration-200 hover:scale-[1.02] hover:shadow-lg active:scale-[0.98] disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:scale-100 disabled:hover:shadow-none\" style=\"background-color: rgb(124, 106, 96); color: rgb(222, 217, 215); box-shadow: rgba(0, 0, 0, 0.2) 0px 4px 12px -2px;\"><span dir=\"auto\">Gửi xác nhận</span></button></form></div></div></div></div>","cls":"fixed inset-0 z-[9999] flex items-center justify-center p-4 transition-all duration-300 bg-black/60 backdrop-blur-sm","vw":390}