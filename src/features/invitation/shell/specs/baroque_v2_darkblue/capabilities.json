{
  "id": "baroque_v2_darkblue",
  "family": "baroque_v2",
  "testId": "baroque-v2-dark-blue-template",
  "innerClass": "relative z-10 flex flex-col items-center gap-[23px] py-[34px] md:gap-[30px] md:py-[44px]",
  "blocks": [
    "Paper",
    "Hero",
    "Ceremony",
    "Album",
    "Banquet",
    "RsvpAction",
    "Venue",
    "DressCode",
    "Schedule",
    "Guestbook",
    "Gifts",
    "ThankYou",
    "Footer",
    "BottomDecor",
    "Lightbox"
  ],
  "cover": {
    "seal": "seal-gold",
    "ambient": "sparkles",
    "particle": "sparkles",
    "skin": "card"
  },
  "gift": {
